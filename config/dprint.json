{
  "$schema": "https://dprint.dev/schemas/v0.json",

  "extends": "../node_modules/@j0nathan-ll0yd/config/dprint.json",

  "includes": [
    "../src/**/*.{ts,tsx,js,jsx}",
    "../test/**/*.{ts,tsx,js,jsx}",
    "./**/*.{ts,js,json}",
    "../*.json",
    "../*.mjs"
  ],

  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.git",
    "../.omc/**",
    "../infra/**"
  ]
}
