{
  "extends": "@j0nathan-ll0yd/config/tsconfig-base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "target": "ES2025",
    "lib": ["ES2025"],
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "paths": {
      "#entities/*": ["./src/entities/*"],
      "#lambdas/*": ["./src/lambdas/*"],
      "#lib/*": ["./src/lib/*"],
      "#config/*": ["./src/config/*"],
      "#types/*": ["./src/types/*"],
      "#test/*": ["./test/*"],
      "#db/*": ["./src/db/*"],
      "#domain/*": ["./src/domain/*"],
      "#services/*": ["./src/services/*"],
      "#integrations/*": ["./src/integrations/*"],
      "#errors/*": ["./src/errors/*"],
      "#utils/*": ["./src/utils/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.fixture.ts",
    "test/**/*",
    "./src/types/terraform.d.ts",
    "src/lib/**/*"
  ]
}
