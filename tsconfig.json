{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "target": "ES2025",
    "lib": ["ES2025"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "#entities/*": ["./src/entities/*"],
      "#lambdas/*": ["./src/lambdas/*"],
      "#lib/*": ["./src/lib/*"],
      "#config/*": ["./src/config/*"],
      "#types/*": ["./src/types/*"],
      "#test/*": ["./test/*"],
      "#db/*": ["./src/db/*"],
      "#domain/*": ["./src/domain/*"],
      "#services/*": ["./src/services/*"],
      "#integrations/*": ["./src/integrations/*"],
      "#errors/*": ["./src/errors/*"],
      "#utils/*": ["./src/utils/*"],
      "drizzle-orm": ["./node_modules/@mantleframework/database/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/@mantleframework/database/node_modules/drizzle-orm/*"],
      "zod": ["./node_modules/@mantleframework/validation/node_modules/zod"],
      "aws-lambda": ["./node_modules/@mantleframework/core/node_modules/@types/aws-lambda"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.fixture.ts",
    "test/**/*",
    "./src/types/terraform.d.ts",
    "src/lib/**/*"
  ]
}
