# Mantle Container Lambda: StartFileUpload
# Includes: Node.js 24, yt-dlp, bgutil, deno, ffmpeg
# Target architecture: x86_64 (matching binary dependencies)

# ===========================================================
# Build bgutil Python plugin (pip install in Lambda Python image)
# ===========================================================
FROM public.ecr.aws/lambda/python:3.12-x86_64 AS bgutil-builder
COPY layers/bgutil/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt -t /opt/python --no-cache-dir --quiet \
  && pip install yt-dlp-ejs==0.8.0 -t /opt/python --no-cache-dir --quiet \
  && chmod -R 755 /opt/python

# ===========================================================
# Binary dependencies (cached independently of app code)
# ===========================================================
FROM public.ecr.aws/lambda/nodejs:24-x86_64 AS base

# Install build utilities missing from minimal Lambda image
RUN microdnf install -y unzip tar xz && microdnf clean all

# --- yt-dlp ---
# This ARG is the single source of truth for the yt-dlp version. It is bumped by
# the automated weekly update (.github/workflows/update-yt-dlp.yml) and the local
# helper (bin/update-yt-dlp.sh), both of which sed this exact line.
ARG YTDLP_VERSION=2026.07.04
ADD --chmod=755 \
  https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux \
  /opt/bin/yt-dlp

# --- bgutil (Rust PO-token provider for yt-dlp) ---
ARG BGUTIL_VERSION=v0.8.1
ADD --chmod=755 \
  https://github.com/jim60105/bgutil-ytdlp-pot-provider-rs/releases/download/${BGUTIL_VERSION}/bgutil-pot-linux-x86_64 \
  /opt/bin/bgutil

# --- Deno (JS runtime for yt-dlp YouTube challenge solving) ---
ARG DENO_VERSION=2.7.7
ADD https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip /tmp/deno.zip
RUN cd /tmp && unzip deno.zip && chmod +x deno && mv deno /opt/bin/deno && rm deno.zip

# --- ffmpeg + ffprobe (static build for stream muxing and analysis) ---
# BtbN/FFmpeg-Builds: pinned to a dated autobuild release + its exact versioned asset
# name (NOT `latest` / `-latest-`). `latest` is a moving pointer -- a same-tag rebuild
# is a silent no-op under this Lambda's IMMUTABLE ECR repo (F2, see
# .omc/plans/omd-prebuilt-container-lambda-2026-08-16.md in ci-runners-private). BtbN
# prunes aggressively: on 2026-08-27 the oldest surviving autobuild was 8 days old and
# the previous pin (autobuild-2026-08-13-17-03) already 404ed, which broke the build
# outright -- BuildKit resolves an ADD URL to compute its cache key, so a pruned release
# fails even when the layer is otherwise cached. Treat the window as ~1 week, not the
# ~15 months a previous revision of this comment assumed. Bump both ARGs together and
# verify the asset URL resolves. The 7.1 line is gone from BtbN entirely (no surviving
# release carries a linux64-gpl-7.1 asset), so this pin tracks 8.1.
ARG FFMPEG_BUILD=autobuild-2026-08-27-16-45
ARG FFMPEG_ASSET=ffmpeg-n8.1.2-47-g156bb4d299-linux64-gpl-8.1
ADD https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_BUILD}/${FFMPEG_ASSET}.tar.xz /tmp/ffmpeg.tar.xz
RUN cd /tmp && tar xf ffmpeg.tar.xz --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' --strip-components=2 \
  && chmod +x ffmpeg ffprobe && mv ffmpeg ffprobe /opt/bin/ && rm ffmpeg.tar.xz

# --- yt-dlp cookies (SOPS-encrypted in repo, decrypted before build) ---
# --chmod=0644 is required, not cosmetic. bin/decrypt-cookies.sh writes the plaintext
# via mktemp, which is mode 0600, and mv preserves it; a bare COPY would carry that
# 0600 into the image as root:root. The Lambda function process runs as a non-root
# sandbox user, so it could not read the source and prepareCookies() failed with
# EACCES -- yt-dlp then ran cookieless and fetchVideoInfo returned no metadata.
# Set the mode here rather than in decrypt-cookies.sh so the image does not depend on
# the build host's umask, and so the decrypted secret stays 0600 at rest on disk.
COPY --chmod=0644 layers/yt-dlp/cookies/youtube-cookies.txt /opt/cookies/youtube-cookies.txt
# --chmod also applies to the parent directories COPY creates implicitly, which leaves
# /opt/cookies at 0644 -- no execute bit, so a non-root user cannot traverse into it and
# the read fails with EACCES even though the file itself is 0644. Restore the search bit
# explicitly; verified by stat-ing both paths in the built image.
RUN chmod 0755 /opt/cookies

# --- bgutil Python plugin for yt-dlp (from builder stage) ---
COPY --from=bgutil-builder /opt/python/ /opt/python/

# ===========================================================
# Application code (changes frequently)
# ===========================================================
COPY build/lambdas/StartFileUpload/index.mjs ${LAMBDA_TASK_ROOT}/index.mjs

# Ensure binaries are on PATH and yt-dlp can discover yt-dlp-ejs solver scripts
ENV PATH="/opt/bin:${PATH}"
ENV PYTHONPATH="/opt/python"

# Lambda handler
CMD ["index.handler"]
