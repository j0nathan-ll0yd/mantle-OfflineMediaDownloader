{
  "name": "mantle-OfflineMediaDownloader",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "adr:new": "./bin/adr-new.sh",
    "audit": "pnpm audit --audit-level=high",
    "audit:aws": "./bin/aws-audit.sh",
    "audit:aws:staging": "./bin/aws-audit.sh --env staging",
    "audit:fix": "pnpm audit --fix",
    "build": "./bin/decrypt-cookies.sh && mantle build",
    "build:ci": "./bin/decrypt-cookies.sh && mantle build --skip-container",
    "cookies:encrypt": "sops encrypt --input-type binary --output-type binary --filename-override youtube-cookies.enc layers/yt-dlp/cookies/youtube-cookies.txt > layers/yt-dlp/cookies/youtube-cookies.enc",
    "check:mcp:entry": "node scripts/check-mcp-entry.mjs",
    "check:package-versions": "node scripts/check-package-versions.mjs",
    "test:package-versions": "node --test scripts/__tests__/check-package-versions.spawn.test.mjs",
    "check:secrets": "./bin/check-secrets.sh",
    "check:test:types": "node bin/tsc6.mjs --project ./tsconfig.test.json --noEmit",
    "check:types": "node bin/tsc6.mjs --project ./tsconfig.json",
    "cleanup": "./bin/cleanup.sh",
    "cleanup:check": "./bin/cleanup.sh --check",
    "cleanup:fast": "./bin/cleanup.sh --fast",
    "db:export": "drizzle-kit export --sql --dialect postgresql",
    "db:generate": "mantle db generate",
    "deploy:staging": "mantle deploy --stage staging",
    "deploy:check": "./bin/pre-deploy-check.sh",
    "deploy:check:staging": "./bin/pre-deploy-check.sh --env staging",
    "deps:check": "dependency-cruiser src --config config/.dependency-cruiser.cjs",
    "deps:graph": "dependency-cruiser src --config config/.dependency-cruiser.cjs --output-type dot | dot -T svg > reports/dependency-graph.svg",
    "deps:report": "dependency-cruiser src --config config/.dependency-cruiser.cjs --output-type html --output-to reports/dependency-report.html",
    "document:terraform": "terraform-docs markdown infra/ > docs/terraform.md",
    "extract:cookies:chrome": "node scripts/extract-youtube-cookies-chrome.mjs",
    "format": "dprint fmt --config config/dprint.json",
    "format:bash": "shfmt -i 2 -ci -sr -w bin/*.sh",
    "format:bash:check": "shfmt -i 2 -ci -sr -d bin/*.sh",
    "format:check": "dprint check --config config/dprint.json",
    "generate:llms": "cat README.md docs/wiki/**/*.md > docs/llms-full.txt",
    "generate:openapi": "mantle generate openapi --schema-prefix 'Models.' --title 'Offline Media Downloader API' --output docs/api/openapi.yaml --html docs/api/index.html",
    "graphrag:extract": "node --import tsx graphrag/extract.ts",
    "graphrag:query": "pnpm dlx tsx graphrag/query.ts",
    "graphrag:validate": "node --import tsx graphrag/validate-metadata.ts",
    "index:codebase": "node --import tsx scripts/indexCodebase.ts",
    "install:prod": "pnpm install --prod",
    "lint": "eslint -c ./eslint.config.mjs .",
    "lint:bash": "shellcheck bin/*.sh .github/scripts/*.sh",
    "lint:fix": "eslint -c ./eslint.config.mjs . --fix",
    "lint:workflows": "./bin/lint-workflows.sh",
    "localstack:health": ". bin/worktree-ports.sh && curl -s \"http://localhost:${LOCALSTACK_PORT:-4566}/_localstack/health\" | jq",
    "localstack:logs": ". bin/worktree-ports.sh && docker compose -f docker/docker-compose.localstack.yml logs -f localstack",
    "localstack:start": ". bin/worktree-ports.sh && docker compose -f docker/docker-compose.localstack.yml up -d",
    "localstack:stop": ". bin/worktree-ports.sh && docker compose -f docker/docker-compose.localstack.yml down",
    "pack:context": "repomix --config config/repomix.config.json",
    "pack:light": "repomix --include \"src/**/*.ts,docs/**/*.md,AGENTS.md\" --ignore \"**/*.test.ts,**/*.spec.ts\"",
    "plan:staging": "mantle deploy --stage staging --dry-run",
    "openspec:covers": "node scripts/openspec-covers-ratchet.mjs",
    "openspec:covers:update": "node scripts/openspec-covers-ratchet.mjs --update-baseline",
    "precheck": "pnpm exec mantle ci --mode pre-push",
    "typecheck": "node bin/tsc6.mjs --noEmit && pnpm run check:test:types",
    "typecheck:ts7": "node bin/tsc7.mjs --noEmit && node bin/tsc7.mjs --project ./tsconfig.test.json --noEmit",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "scaffold:test": "node --import tsx scripts/scaffoldTest.ts",
    "search:codebase": "node --import tsx scripts/searchCodebase.ts",
    "state:verify": "./bin/verify-state.sh",
    "state:verify:staging": "./bin/verify-state.sh --env staging",
    "test": "export LOG_LEVEL=${LOG_LEVEL:-SILENT} && vitest run --config vitest.config.mts",
    "test:eslint:rules": "node config/eslint-local-rules/test/no-direct-aws-sdk-import.test.cjs && node config/eslint-local-rules/test/no-domain-leakage.test.cjs && node config/eslint-local-rules/test/use-entity-mock-helper.test.cjs && node config/eslint-local-rules/test/integration-test-localstack.test.cjs && node config/eslint-local-rules/test/aws-sdk-mock-pattern.test.cjs",
    "test:integration": ". bin/worktree-ports.sh && export LOG_LEVEL=${LOG_LEVEL:-SILENT} POWERTOOLS_LOG_LEVEL=${POWERTOOLS_LOG_LEVEL:-SILENT} NODE_NO_WARNINGS=1 && USE_LOCALSTACK=true vitest run --config vitest.integration.config.mts",
    "test:mutation": "stryker run config/stryker.config.json",
    "test:mutation:auth": "stryker run config/stryker.config.json --mutate 'src/lambdas/standalone/ApiGatewayAuthorizer/**/*.ts,src/lambdas/api/user/**/*.ts'",
    "test:mutation:incremental": "stryker run config/stryker.config.json --incremental",
    "test:remote:hook:staging": "./bin/test-hook.sh --env staging",
    "test:remote:list:staging": "./bin/test-list.sh --env staging",
    "test:remote:register:device:staging": "./bin/test-registerDevice.sh --env staging",
    "update:agents:prs": "./bin/update-agents-prs.sh",
    "update:ffmpeg": "./bin/update-ffmpeg.sh",
    "update:ffmpeg:check": "./bin/update-ffmpeg.sh --check-only",
    "update:ytdlp": "./bin/update-yt-dlp.sh",
    "update:ytdlp:check": "./bin/update-yt-dlp.sh check",
    "validate:env-vars": "mantle check env-vars",
    "validate:doc:sync": "./bin/validate-doc-sync.sh",
    "validate:docs": "./bin/validate-docs.sh",
    "validate:docs:freshness": "./bin/validate-docs-freshness.sh",
    "validate:graphrag": "./bin/validate-graphrag.sh",
    "check:conventions": "mantle check --severity HIGH"
  },
  "author": "Jonathan Lloyd",
  "dependencies": {
    "@j0nathan-ll0yd/auth": "^1.1.3",
    "@j0nathan-ll0yd/aws": "^1.0.3",
    "@j0nathan-ll0yd/core": "^1.2.2",
    "@j0nathan-ll0yd/database": "^2.0.1",
    "@j0nathan-ll0yd/env": "^1.0.0",
    "@j0nathan-ll0yd/errors": "^1.0.0",
    "@j0nathan-ll0yd/mcp": "^1.4.3",
    "@j0nathan-ll0yd/observability": "^1.0.1",
    "@j0nathan-ll0yd/resilience": "^1.0.2",
    "@j0nathan-ll0yd/validation": "^2.0.5",
    "@octokit/rest": "^22.0.1",
    "apns2": "12.2.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.9",
    "zod": "4.4.3"
  },
  "sideEffects": false,
  "imports": {
    "#db/*": "./src/db/*",
    "#domain/*": "./src/domain/*",
    "#services/*": "./src/services/*",
    "#integrations/*": "./src/integrations/*",
    "#errors/*": "./src/errors/*",
    "#utils/*": "./src/utils/*",
    "#entities/*": "./src/entities/*",
    "#lambdas/*": "./src/lambdas/*",
    "#config/*": "./src/config/*",
    "#types/*": "./src/types/*",
    "#test/*": "./test/*"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1101.0",
    "@aws-sdk/client-dynamodb": "3.1101.0",
    "@aws-sdk/client-eventbridge": "3.1101.0",
    "@aws-sdk/client-lambda": "3.1101.0",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/client-sns": "3.1101.0",
    "@aws-sdk/client-sqs": "3.1101.0",
    "@aws-sdk/lib-dynamodb": "3.1101.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@j0nathan-ll0yd/cli": "^2.12.2",
    "@j0nathan-ll0yd/config": "^1.2.1",
    "@j0nathan-ll0yd/eslint-config": "^1.1.0",
    "@j0nathan-ll0yd/testing": "^1.1.4",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@swc/core": "^1.15.43",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.1.0",
    "dependency-cruiser": "^18.1.0",
    "dprint": "^0.55.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-tsdoc": "^0.5.2",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "mock-jwks": "^3.3.5",
    "puppeteer-core": "^25.3.0",
    "repomix": "^1.16.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-monocart-coverage": "^4.0.2"
  }
}
