{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "#entities/*": ["./src/entities/*"],
      "#lambdas/*": ["./src/lambdas/*"],
      "#lib/*": ["./src/lib/*"],
      "#config/*": ["./src/config/*"],
      "#types/*": ["./src/types/*"],
      "#test/*": ["./test/*"],
      "#db/*": ["./src/db/*"],
      "#domain/*": ["./src/domain/*"],
      "#services/*": ["./src/services/*"],
      "#integrations/*": ["./src/integrations/*"],
      "#errors/*": ["./src/errors/*"],
      "#utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.fixture.ts"
  ]
}
